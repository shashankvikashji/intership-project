# --- Server ---
PORT=5000
# Leave empty to run in zero-setup demo mode (in-memory store + seed data).
MONGO_URI=
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: NewsAPI.org key. When set, the provider abstraction can fetch live headlines.
NEWS_API_KEY=

# --- Client (create client/.env for local overrides) ---
# VITE_API_URL=http://localhost:5000/api
