# Copy to server/.env (or project root .env when running from the repo root):
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
# Never commit real secrets. Values below are safe placeholders.

# API port (default 5000)
PORT=5000

# MongoDB connection string. Leave empty to run in zero-setup
# in-memory demo mode (seed data + demo account, nothing persisted).
MONGO_URI=

# JWT signing secret. REQUIRED in production — set a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime, e.g. 7d, 24h
JWT_EXPIRES_IN=7d

# Allowed CORS origin for the web app
CLIENT_URL=http://localhost:5173

# Legacy NewsAPI.org key (optional, currently unused by the live path)
NEWS_API_KEY=

# GNews (https://gnews.io) key for today's live headlines.
# Empty = /api/live serves local demo data. Free tier ~100 req/day.
GNEWS_API_KEY=

# Optional AI provider for summaries + Ask Lumen (OpenAI-compatible
# chat-completions API). Empty = built-in extractive fallback (no key needed).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Comma-separated emails granted the (read-only) admin dashboard.
ADMIN_EMAILS=demo@lumen.news

# Client override for the API base URL (Vite). Default /api (proxied to :5000).
# VITE_API_URL=
